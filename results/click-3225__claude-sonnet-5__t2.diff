@@ -2825,8 +2825,16 @@ class Option(Parameter):
         # and a flag_value set to something else. Refs:
         # https://github.com/pallets/click/issues/3024#issuecomment-3146199461
         # https://github.com/pallets/click/pull/3030/commits/06847da
+        #
+        # This alignment produces the concrete value the flag represents, not a
+        # factory to call lazily, so it must not be invoked even if it happens to be
