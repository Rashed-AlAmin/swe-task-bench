@@ -2896,6 +2903,27 @@ class Option(Parameter):
             result += f" (env var: '{self.envvar}')"
         return result
 
+    def get_default(
+        self, ctx: Context, call: bool = True
+    ) -> t.Any | t.Callable[[], t.Any] | None:
+        # For a non-boolean flag, ``default`` may have been aligned to
+        # ``flag_value`` in __init__ (when the user passed ``default=True``).
+        # That value is the literal value the flag resolves to, not a
+        # callable factory, even if it happens to be callable (e.g. a class
+        # used as a sentinel). It must never be called, regardless of the
+        # ``call`` argument. This is distinct from a user explicitly setting
+        # ``default`` to a callable themselves, which is still invoked as a
+        # dynamic default factory.
+        value = super().get_default(ctx, call=False)
+
+        if self._default_is_flag_value and value is self.default:
+            return value
+
+        if call and callable(value):
+            value = value()
+
+        return value
