@@ -18,6 +18,14 @@ class Sentinel(enum.Enum):
     def __repr__(self) -> str:
         return f"{self.__class__.__name__}.{self.name}"
 
+    def __reduce_ex__(self, protocol: int) -> tuple[t.Any, t.Any]:
+        # The default Enum pickling reconstructs members by looking up
+        # their value. Since the values here are unique `object()`
+        # instances that don't survive a pickle/copy round-trip with
+        # their identity intact, that lookup fails. Reconstruct by name
+        # instead, which is stable across pickling and copying.
+        return getattr, (self.__class__, self.name)
+
 
 UNSET: t.Literal[Sentinel.UNSET] = Sentinel.UNSET
 """Sentinel used to indicate that a value is not set."""
