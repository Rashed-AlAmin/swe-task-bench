@@ -18,6 +18,16 @@ class Sentinel(enum.Enum):
     def __repr__(self) -> str:
         return f"{self.__class__.__name__}.{self.name}"
 
+    def __reduce_ex__(self, protocol: int) -> tuple[t.Any, ...]:
+        # The default Enum pickling round-trips through the member's value, but
+        # these values are plain `object()` instances that aren't preserved by
+        # pickling, so the lookup on unpickling fails. Pickle by name instead,
+        # looking the singleton member back up via attribute access. This also
+        # fixes `copy`/`deepcopy` on Python < 3.11, which fall back to
+        # `__reduce_ex__` since `Enum` didn't define `__copy__`/`__deepcopy__`
+        # until 3.11.
+        return getattr, (self.__class__, self.name)
+
 
 UNSET: t.Literal[Sentinel.UNSET] = Sentinel.UNSET
 """Sentinel used to indicate that a value is not set."""
