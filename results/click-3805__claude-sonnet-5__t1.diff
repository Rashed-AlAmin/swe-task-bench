--- a/src/click/_utils.py
+++ b/src/click/_utils.py
@@ -18,6 +18,13 @@ class Sentinel(enum.Enum):
     def __repr__(self) -> str:
         return f"{self.__class__.__name__}.{self.name}"
 
+    def __reduce_ex__(self, protocol: int) -> tuple[t.Any, ...]:
+        # The default Enum pickling round-trips through the member's value,
+        # which here is a plain ``object()`` that doesn't survive pickling
+        # with its identity intact. Reduce by name instead so the same
+        # singleton member is restored by pickle and by copy/deepcopy.
+        return (getattr, (self.__class__, self.name))
+
 
 UNSET: t.Literal[Sentinel.UNSET] = Sentinel.UNSET
 """Sentinel used to indicate that a value is not set."""
