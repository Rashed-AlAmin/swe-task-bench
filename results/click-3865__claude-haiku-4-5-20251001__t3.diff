+        if word[-1] == ".":  # potential sentence end
+            # Only treat as sentence boundary if the word (minus period) is not
+            # entirely lowercase letters. This avoids stopping at abbreviations
+            # like "vs.", "e.g.", "i.e." which are common in help text.
+            word_without_period = word[:-1]
+            if word_without_period and not word_without_period.isalpha():
+                # Contains non-alphabetic characters, likely a sentence end
+                return " ".join(words[: i + 1])
+            elif word_without_period and word_without_period.islower():
+                # All lowercase letters, likely an abbreviation, continue
+                continue
+            elif word_without_period:
+                # Contains uppercase letters, likely a sentence end
+                return " ".join(words[: i + 1])
 
