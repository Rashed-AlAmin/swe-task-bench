index 23d1dd5..f5dd848 100644
--- a/src/click/core.py
+++ b/src/click/core.py
@@ -2890,6 +2890,33 @@ class Option(Parameter):
         )
         return info_dict
 
+    def get_default(
+        self, ctx: Context, call: bool = True
+    ) -> t.Any | t.Callable[[], t.Any] | None:
+        """Get the default for the parameter.
+
+        For flag options with a flag_value, don't call callable defaults.
+        This prevents classes used as flag_value or default from being
+        instantiated, allowing the user to instantiate them with custom
+        parameters.
+
+        :meta private:
+        """
+        name = self.name
+        value = ctx.lookup_default(name, call=False) if name is not None else None
+
+        if value is None and not (
+            ctx.default_map is not None and name is not None and name in ctx.default_map
+        ):
+            value = self.default
+
+        # For flag options with a flag_value, don't call callable defaults.
+        # This prevents unintended instantiation of classes used as defaults.
+        if call and callable(value) and not (self.is_flag and self.flag_value is not UNSET):
+            value = value()
+
+        return value
+
     def get_error_hint(self, ctx: Context) -> str:
