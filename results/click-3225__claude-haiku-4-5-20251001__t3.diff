-        if call and callable(value):
+        if call and callable(value) and not isinstance(value, type):
             value = value()
 
         return value
@@ -2825,8 +2825,15 @@ class Option(Parameter):
         # and a flag_value set to something else. Refs:
         # https://github.com/pallets/click/issues/3024#issuecomment-3146199461
         # https://github.com/pallets/click/pull/3030/commits/06847da
+        self._default_from_flag_value = False
+        self._default_is_true_no_flag_value = False
         if self.default is True and self.flag_value is not UNSET:
             self.default = self.flag_value
+            self._default_from_flag_value = True
+        elif self.default is True and self.flag_value is UNSET:
+            # Mark that the original default was True with no flag_value
+            # In this case, type conversion should happen
+            self._default_is_true_no_flag_value = True
 
         # Set the default flag_value if it is not set.
         if self.flag_value is UNSET:
@@ -3317,6 +3324,24 @@ class Option(Parameter):
 
             return value
 
+        # For flags with explicit class defaults (not from flag_value and not default=True),
+        # skip type conversion and return the value as-is. This preserves the type of
+        # explicit class defaults.
+        source = ctx.get_parameter_source(self.name)
+        if (
+            self.is_flag
+            and value is not UNSET
+            and source in (ParameterSource.DEFAULT, ParameterSource.DEFAULT_MAP)
+            and not self._default_from_flag_value
+            and not self._default_is_true_no_flag_value
+            and isinstance(value, type)
+        ):
+            # Skip type conversion for explicit class defaults by calling the callback
+            # directly and returning the value. The required check is skipped for defaults.
+            if self.callback is not None:
+                value = self.callback(ctx, self, value)
+            return value
+
         # in the normal case, rely on Parameter.process_value
         return super().process_value(ctx, value)
 
