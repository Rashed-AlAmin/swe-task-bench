+    def get_default(
+        self, ctx: Context, call: bool = True
+    ) -> t.Any | t.Callable[[], t.Any] | None:
+        """Like :meth:`Parameter.get_default`, but avoids calling the
+        default when it was aligned to :attr:`flag_value` (because
+        ``default=True`` was given). That alignment is a literal sentinel
+        substitution, not the declaration of a lazy default factory, so it
+        must not be called even if ``flag_value`` happens to be callable
+        (for example, a class).
+        """
+        value = super().get_default(ctx, call=False)
+
+        if (
+            call
+            and callable(value)
+            and not (self._default_is_flag_value and value is self.flag_value)
+        ):
+            value = value()
+
+        return value
+
