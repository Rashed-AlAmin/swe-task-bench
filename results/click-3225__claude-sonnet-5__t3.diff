@@ -2896,6 +2902,22 @@ class Option(Parameter):
             result += f" (env var: '{self.envvar}')"
         return result
 
+    def get_default(
+        self, ctx: Context, call: bool = True
+    ) -> t.Any | t.Callable[[], t.Any] | None:
+        # When the default was automatically aligned to flag_value (because
+        # the user passed default=True as a shorthand), the default is the
+        # flag_value verbatim, exactly as if the flag had been activated on
+        # the command line. It must not be treated as a callable factory,
+        # even if flag_value happens to be callable itself (e.g. a class
+        # used as a sentinel value). A default explicitly provided by the
+        # user, even if it happens to equal flag_value, is unaffected and
+        # is still called as usual.
+        if self._default_is_flag_value_alias:
+            return self.flag_value
+
+        return super().get_default(ctx, call=call)
