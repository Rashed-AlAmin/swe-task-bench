--- a/src/click/core.py
+++ b/src/click/core.py
@@ -1169,8 +1169,21 @@ class Command:
             # Avoid circular import.
             from .decorators import help_option
 
-            # Apply help_option decorator and pop resulting option
-            help_option(*help_option_names)(self)
+            # Collect existing parameter names to avoid collisions
+            existing_names = {param.name for param in self.params}
+
+            # Determine the name for the help option that won't collide
+            help_param_name = "help"
+            if help_param_name in existing_names:
+                # Find an alternative name if "help" collides
+                for candidate in ["__help__", "help_option", "__help_option__"]:
+                    if candidate not in existing_names:
+                        help_param_name = candidate
+                        break
+
+            # Apply help_option decorator with the explicit name
+            # and pop resulting option
+            help_option(help_param_name, *help_option_names)(self)
             self._help_option = self.params.pop()  # type: ignore[assignment]
 
         return self._help_option
