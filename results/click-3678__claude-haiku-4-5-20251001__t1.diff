+
+        # Also check if any existing parameter name would conflict with
+        # the destination name of a help option. For example, if a parameter
+        # is named "help", it would conflict with "--help" which also has
+        # destination name "help".
+        existing_names = {param.name for param in self.params}
+        help_names_to_remove = set()
+        for help_opt in all_names:
+            # Derive the destination name from the option flag
+            opt_prefix, opt_name = _split_opt(help_opt)
+            dest_name = opt_name.replace("-", "_").lower()
+            if dest_name in existing_names:
+                help_names_to_remove.add(help_opt)
+        all_names.difference_update(help_names_to_remove)
+
         return list(all_names)
 
