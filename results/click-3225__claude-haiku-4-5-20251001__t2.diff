index 23d1dd5..15a0713 100644
--- a/src/click/core.py
+++ b/src/click/core.py
@@ -3239,6 +3239,25 @@ class Option(Parameter):
 
         return rv
 
+    def get_default(
+        self, ctx: Context, call: bool = True
+    ) -> t.Any | t.Callable[[], t.Any] | None:
+        """Get the default for this option.
+
+        For flags with a flag_value, the flag_value should not be called
+        even if it is callable, since it is intended as a constant value.
+
+        :meta private:
+        """
+        value = super().get_default(ctx, call=False)
+
+        # For flags, never call the flag_value even if it is callable.
+        # The flag_value is a constant that should be used as-is.
+        if call and callable(value) and not (self.is_flag and value is self.flag_value):
+            value = value()
+
+        return value
+
     def consume_value(
         self, ctx: Context, opts: cabc.Mapping[str, Parameter]
     ) -> tuple[t.Any, ParameterSource]:
