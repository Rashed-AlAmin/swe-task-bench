@@ -2896,6 +2900,33 @@ class Option(Parameter):
             result += f" (env var: '{self.envvar}')"
         return result
 
+    def get_default(
+        self, ctx: Context, call: bool = True
+    ) -> t.Any | t.Callable[[], t.Any] | None:
+        """Get the default for the parameter. For flags where default=True was
+        converted to default=flag_value, avoid calling the flag_value if it's a class.
+
+        :meta private:
+        """
+        name = self.name
+        value = ctx.lookup_default(name, call=False) if name is not None else None
+
+        if value is None and not (
+            ctx.default_map is not None and name is not None and name in ctx.default_map
+        ):
+            value = self.default
+
+        # For flags where default=True was converted to the flag_value, don't call
+        # the value if it's a class. Classes are meant to be used as-is, not
+        # instantiated as the default.
+        if call and callable(value) and not (
+            self.is_flag and self._default_from_flag_value and value is self.flag_value
+            and inspect.isclass(value)
+        ):
+            value = value()
+
+        return value
