diff --git a/src/click/exceptions.py b/src/click/exceptions.py
index 4d782ee..f33bd17 100644
--- a/src/click/exceptions.py
+++ b/src/click/exceptions.py
@@ -74,14 +74,18 @@ class UsageError(ClickException):
             file = get_text_stderr()
         color = None
         hint = ""
-        if (
-            self.ctx is not None
-            and self.ctx.command.get_help_option(self.ctx) is not None
-        ):
-            hint = _("Try '{command} {option}' for help.").format(
-                command=self.ctx.command_path, option=self.ctx.help_option_names[0]
-            )
-            hint = f"{hint}\n"
+        if self.ctx is not None:
+            help_option = self.ctx.command.get_help_option(self.ctx)
+
+            if help_option is not None:
+                # Prefer the long form (e.g. ``--help``) if it is available,
+                # since a short form like ``-h`` may have been reused by
+                # another option on this command.
+                option_name = max(help_option.opts, key=len)
+                hint = _("Try '{command} {option}' for help.").format(
+                    command=self.ctx.command_path, option=option_name
+                )
+                hint = f"{hint}\n"
         if self.ctx is not None:
             color = self.ctx.color
             echo(f"{self.ctx.get_usage()}\n{hint}", file=file, color=color)
