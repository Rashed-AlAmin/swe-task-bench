+#: Common abbreviations whose trailing "." should not be mistaken for
+#: the end of a sentence.
+_ABBREVIATIONS = {"e.g.", "i.e.", "etc.", "vs."}
+
+
+def _is_sentence_end(words: list[str], index: int) -> bool:
+    """Whether the word at ``index`` (which ends with ".") actually ends
+    a sentence, rather than being an abbreviation or a period that's
+    followed by a lowercase continuation of the same sentence.
+    """
+    word = words[index]
+
+    if word.lower() in _ABBREVIATIONS:
+        return False
+
+    if index == len(words) - 1:
+        return True
+
+    next_word = words[index + 1]
+    return next_word[:1].isupper()
+
