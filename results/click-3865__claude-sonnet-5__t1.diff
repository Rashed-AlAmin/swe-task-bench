+        if word[-1] == ".":
+            # A trailing "." only ends the sentence if it's the last word,
+            # or the next word doesn't look like a continuation of the same
+            # sentence (e.g. an abbreviation like "vs." or "e.g." followed
+            # by a lowercase word). Periods after digits (e.g. list markers
+            # like "9.") are still always treated as sentence ends.
+            is_sentence_end = (
+                i == last_index
+                or not words[i + 1][0].islower()
+                or any(ch.isdigit() for ch in word)
+            )
+
+            if is_sentence_end:
+                # sentence end, truncate without "..."
+                return " ".join(words[: i + 1])
 
         if total_length == max_length and i != last_index:
