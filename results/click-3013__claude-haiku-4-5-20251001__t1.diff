+@pytest.mark.parametrize(
+    ("env", "expect"),
+    [
+        # Unquoted prefix
+        (
+            {"COMP_WORDS": "cli ", "COMP_CWORD": ""},
+            "plain,a\nplain,b\tbee\n",
+        ),
+        # Double-quoted prefix with text
+        (
+            {"COMP_WORDS": 'cli "a', "COMP_CWORD": '"a'},
+            "plain,a\n",
+        ),
+        # Single-quoted prefix with text
+        (
+            {"COMP_WORDS": "cli 'a", "COMP_CWORD": "'a"},
+            "plain,a\n",
+        ),
+        # Quoted prefix with space (completion for values with spaces)
+        (
+            {"COMP_WORDS": 'cli "b', "COMP_CWORD": '"b'},
+            "plain,b\tbee\n",
+        ),
+    ],
+)
+@pytest.mark.usefixtures("_patch_for_completion")
+def test_fish_complete_with_quoted_values(runner, env: Mapping[str, str], expect: str) -> None:
+    cli = Group("cli", commands=[Command("a"), Command("b", help="bee")])
+    result = runner.invoke(
+        cli,
+        env={
+            **env,
+            "_CLI_COMPLETE": "fish_complete",
+        },
+    )
+    assert result.output == expect
+
+
