+def test_fish_completion_with_quotes():
+    DATASETS = ["Sales Q1", "Sales Q2", "backfill"]
+
+    def custom_complete(ctx, param, incomplete):
+        return [d for d in DATASETS if d.startswith(incomplete)]
+
+    cli = Command(
+        "cli",
+        params=[
+            Option(["--dataset"], shell_complete=custom_complete),
+        ],
+    )
+
+    # Test unquoted prefix
+    words = _get_words(cli, ["--dataset"], "Sa")
+    assert "Sales Q1" in words
+    assert "Sales Q2" in words
+    assert len(words) == 2
+
+    # Fish-specific test: quoted prefix should still work
+    # We test this by directly using FishComplete with environment variables
+    import os
+
+    os.environ["COMP_WORDS"] = 'cli --dataset "Sa'
+    os.environ["COMP_CWORD"] = '"Sa'
+
+    from click.shell_completion import FishComplete
+
+    fish_comp = FishComplete(cli, {}, "cli", "_CLI_COMPLETE")
+    args, incomplete = fish_comp.get_completion_args()
+
+    # After processing, args should be ["--dataset"] and incomplete should be "Sa" (without quote)
+    assert args == ["--dataset"]
+    assert incomplete == "Sa"
+
+    # Now test get_completions
+    completions = fish_comp.get_completions(args, incomplete)
+    assert len(completions) == 2
+    assert completions[0].value == "Sales Q1"
+    assert completions[1].value == "Sales Q2"
+
