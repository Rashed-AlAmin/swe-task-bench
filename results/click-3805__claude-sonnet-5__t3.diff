index 05ee2e9..ad7080e 100644
--- a/src/click/_utils.py
+++ b/src/click/_utils.py
@@ -18,6 +18,14 @@ class Sentinel(enum.Enum):
     def __repr__(self) -> str:
         return f"{self.__class__.__name__}.{self.name}"
 
+    def __reduce_ex__(self, protocol: int) -> t.Any:
+        # The default Enum reduction reconstructs a member by looking up its
+        # value, but these values are unique ``object()`` instances that
+        # don't survive a pickle round-trip (a copy won't equal any member's
+        # value). Reconstruct by name instead, which ``copy``/``deepcopy``
+        # also rely on via this same method.
+        return getattr, (self.__class__, self.name)
+
 
 UNSET: t.Literal[Sentinel.UNSET] = Sentinel.UNSET
 """Sentinel used to indicate that a value is not set."""
